linux.release.x86_64 = "res://addons/bv1d/bin/libbv1d.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/bv1d/bin/libbv1d.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/bv1d/bin/libbv1d.windows.template_release.x86_64.dll"
